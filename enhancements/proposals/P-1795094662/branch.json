 "property_registry_policy": {
  "enforcement": "incremental",
  "note": "incremental：新增属性必须先注册（门禁拦截未注册新属性）；存量属性未注册的标记 legacy 不报错。strict 模式全部强制。",
  "legacy_grace": true
 },
 "interfaces": [
  {
   "id": "Chargeable",
   "label": "可计费对象",
   "description": "携带金额属性、可进入费用拆解与对账流程的对象。",
   "match": "structural",
   "required_properties": [
    "status"
   ],
   "required_any_of": [
    "actual_fee",
    "actual_amount",
    "quoted_amount"
   ],
   "owner": "freight-core",
   "version": "1.0.0"
  },
  {
   "id": "Party",
   "label": "业务主体",
   "description": "有名称与联系方式的参与方（货主、司机等）。",
   "match": "structural",
   "required_properties": [
    "status"
   ],
   "required_any_of": [
    "shipper_name",
    "driver_name"
   ],
   "owner": "freight-core",
   "version": "1.0.0"
  },
  {
   "id": "TemporalTracked",
   "label": "状态时序跟踪对象",
   "description": "状态属性为时序属性，支持按时间点查询历史值。",
   "match": "structural",
   "required_properties": [
    "status"
   ],
   "required_timeseries": [
    "status"
   ],
   "owner": "freight-core",
   "version": "1.0.0"
  }
 ],
 "markings": [
  {
   "id": "PII",
   "label": "个人信息",
   "description": "姓名、联系方式等个人信息。无标记用户不可读，角色再高也不豁免（强制控制）。",
   "category": "Information",
   "members": [
    "freight-core",
    "compliance-ops"
   ]
  },
  {
   "id": "FINANCE",
   "label": "财务敏感",
   "description": "金额类字段。仅结算与财务角色可读。",
   "category": "Finance",
   "members": [
    "freight-core",
    "settlement-ops"
   ]
  },
  {
   "id": "DISPUTE_OPS",
   "label": "争议处理",
   "description": "争议状态的费用项仅争议处理组可见（行级安全示例）。",
   "category": "Operations",
   "members": [
    "dispute-ops",
    "freight-core"
   ]
  }
 ],
 "object_security_policies": [
  {
   "id": "osp-feeitem-disputed",
   "object_type": "FeeItem",
   "description": "DISPUTED 状态的费用项仅 DISPUTE_OPS 标记成员可见（行级）。",
   "row_filter": {
    "property": "status",
    "equals": "DISPUTED"
   },
   "required_marking": "DISPUTE_OPS"
  }
 ],
 "property_security_policies": [
  {
   "id": "psp-pii",
   "description": "PII 标记属性列级脱敏：无 PII 标记的用户读到 null。",
   "properties": [
    "shipper_name",
    "contact",
    "driver_name"
   ],
   "required_marking": "PII"
  },
  {
   "id": "psp-finance",
   "description": "FINANCE 标记属性列级脱敏：无 FINANCE 标记的用户读到 null。",
   "properties": [
    "estimated_fee",
    "actual_fee",
    "variance"
   ],
   "required_marking": "FINANCE"
  }
 ],
 "scope_tokens": {
  "note": "LLM agent 令牌最小化：令牌携带可见类/函数子集，服务端按令牌过滤工具面。",
  "default_token": {
   "id": "agent-readonly",
   "classes": [
    "Waybill",
    "FeeItem",
    "Shipper",
    "Driver"
   ],
   "functions": [
    "fee_breakdown",
    "quote_reconcile"
   ],
   "mcp_tools": [
    "ontology.catalog",
    "ontology.object_type_search",
    "ontology.schema"
   ]
  }
 },
 "function_registry": [
  {
   "id": "fee_breakdown",
   "label": "费用拆解",
   "version": "1.1.0",
   "owner": "freight-core",
   "implementation": "freight.engine.FreightSystem.fee_analysis",
   "description": "确定性拆解运单的报价、规则应计、实收、减免和差异。",
   "signature": {
    "params": [
     {
      "name": "waybill_id",
      "type": "string",
      "required": true
     },
     {
      "type": "string",
      "name": "version",
      "required": false
     }
    ],
    "returns": "FeeBreakdown"
   },
   "sandbox": {
    "timeout_ms": 5000,
    "memory_mb": 256
   },
   "accepts_interface": null,
   "tests": [
    {
     "name": "wb001-fee-sum-closes",
     "args": {
      "waybill_id": "waybill:WB20261105001"
     },
     "expect": {
      "status": "EXPLAINED"
     }
    }
   ]
  },
  {
   "id": "quote_reconcile",
   "label": "报价对账",
   "version": "1.0.0",
   "owner": "freight-core",
   "implementation": "freight.engine.FreightSystem.quote_reconcile",
   "description": "确定性对比订单报价明细与实际费用。",
   "signature": {
    "params": [
     {
      "name": "waybill_id",
      "type": "string",
      "required": true
     }
    ],
    "returns": "QuoteReconcile"
   },
   "sandbox": {
    "timeout_ms": 5000,
    "memory_mb": 256
   },
   "accepts_interface": "Chargeable",
   "tests": []
  },
  {
   "id": "chargeable_variance",
   "label": "可计费对象差异计算（接口多态示例）",
   "version": "1.0.0",
   "owner": "freight-core",
   "implementation": "enhancements.interfaces.compute_variance",
   "description": "按 Chargeable 接口接受任意实现类，计算金额口径差异；演示接口多态的函数路由。",
   "signature": {
    "params": [
     {
      "name": "object_id",
      "type": "string",
      "required": true,
      "interface": "Chargeable"
     }
    ],
    "returns": "number"
   },
   "sandbox": {
    "timeout_ms": 3000,
    "memory_mb": 128
   },
   "accepts_interface": "Chargeable",
   "tests": []
  }
 ],

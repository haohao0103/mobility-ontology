  "pricing": {
    "waiting": {
      "free_minutes": 20,
      "block_minutes": 5,
      "per_block": 2.4,
      "rule_id": "R-WAIT-01"
    },
    "highway": {
      "source": "ETC",
      "rule_id": "R-HIGHWAY-01"
    }
  },
  "data_sources": [

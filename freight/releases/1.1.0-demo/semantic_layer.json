{
  "meta": {
    "name": "货拉拉订单本体 · 可执行语义层",
    "version": "1.1.0-demo",
    "scope": "从货主下单、订单生成运单、司机承运、费用产生、结算开票到异常处理",
    "note": "本体只持久化类、关系、规则、动作与数据源映射；业务事实经 MCP / API 按需查询，不写入本体库。",
    "storage_policy": "knowledge-only",
    "based_on": "1.0.0",
    "released_at": "2026-11-18T09:41:19+08:00"
  },

    },
    {
      "class": "Driver",
      "system": "TMS",
      "tool": "tms.get_driver",
      "key": "driver_id",
      "description": "司机档案与从业资质，按 driver_id 读取。"
    },
    {
      "class": "Vehicle",
      "system": "TMS",
      "tool": "tms.get_vehicle",
      "key": "vehicle_id",
      "description": "车辆档案、车型与载重，按 vehicle_id 读取。"
    },
    {
      "class": "FeeItem",
      "system": "计费中心",
      "tool": "billing.list_fee_items",

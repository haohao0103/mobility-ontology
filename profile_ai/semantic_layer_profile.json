  "classes": [
    {
      "id": "Crowd",
      "label": "人群",
      "kind": "crowd",
      "description": "由标签、规则或派生关系定义的可计算人群资产。",
      "properties": ["name", "display_name", "description", "status", "status_reason", "owner", "domain", "source_system", "source_id", "source_url", "keywords", "estimated_size", "target_size", "priority", "permission_scope", "rule_expression", "rule_language", "referenced_tags", "scope", "crowd_type", "expected_city_count", "intent_vehicle_type", "intent_sticker_status", "intent_expected_city_count", "intent_managed_cities", "created_at", "updated_at", "metadata"],
      "required": ["name", "status", "owner", "source_system", "source_id"],
      "indexes": ["status", "source_system", "name"]
    },
    {
      "id": "Tag",
      "label": "标签",
      "kind": "tag",
      "description": "描述用户属性、行为或价值的原子语义标签。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "definition", "expression", "value_type", "keywords", "created_at", "updated_at", "metadata"],
      "required": ["name", "definition", "source_system", "source_id"],
      "indexes": ["status", "source_system", "name"]
    },
    {
      "id": "Strategy",
      "label": "策略",
      "kind": "strategy",
      "description": "面向人群的运营/触达策略，包含规则、动作、渠道与生效窗口。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "rule", "action", "trigger_type", "channel", "risk_level", "priority", "effective_from", "effective_to", "created_at", "updated_at", "metadata"],
      "required": ["name", "status", "owner", "source_system", "source_id"],
      "indexes": ["status", "source_system", "name"]
    },
    {
      "id": "CanvasTask",
      "label": "画布任务",
      "kind": "canvas",
      "description": "画布编排中的可执行任务，负责把人群与策略发布到目标渠道。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "canvas_id", "canvas_name", "task_type", "schedule", "audience_rule", "publish_channel", "last_run_at", "next_run_at", "result", "error_message", "created_at", "updated_at", "metadata"],
      "required": ["name", "status", "owner", "source_system", "source_id"],
      "indexes": ["status", "source_system", "name"]
    },
    {
      "id": "Metric",
      "label": "指标",
      "kind": "metric",
      "description": "可被语义层解释、追溯和复用的业务指标定义与观测值。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "metric_id", "metric_name", "value", "value_type", "unit", "period", "sample_size", "direction", "definition", "expression", "created_at", "updated_at", "metadata"],
      "required": ["name", "definition", "source_system", "source_id"],
      "indexes": ["status", "source_system", "name"]
    },
    {
      "id": "Evidence",
      "label": "证据",
      "kind": "evidence",
      "description": "支撑人群、标签、策略或指标结论的可追溯证据。",
      "properties": ["name", "description", "source_system", "source_id", "source_url", "evidence_type", "content", "observed_at", "confidence", "sample_size", "created_at", "updated_at", "metadata"],
      "required": ["name", "evidence_type", "content", "observed_at", "source_system", "source_id"],
      "indexes": ["source_system", "evidence_type", "observed_at"]
    },
    {
      "id": "Version",
      "label": "版本",
      "kind": "version",
      "description": "资产变更快照，形成可回溯的版本时间线。",
      "properties": ["name", "description", "version", "previous_version", "change_summary", "status", "source_system", "source_id", "created_at", "updated_at", "metadata"],
      "required": ["name", "version", "source_system", "source_id"],
      "indexes": ["status", "source_system", "version"]
    },
    {
      "id": "Operator",
      "label": "操作人",
      "kind": "operator",
      "description": "资产创建、变更、确认和发布的自然人/系统账号。",
      "properties": ["name", "display_name", "role", "account", "email", "status", "source_system", "source_id", "created_at", "updated_at", "metadata"],
      "required": ["name", "role"],
      "indexes": ["status", "account", "role"]
    },
    {
      "id": "Driver",
      "label": "司机",
      "kind": "driver",
      "description": "货运/出行业务中的司机主体，是人群规则的作用对象。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "driver_id", "vehicle_type", "sticker_status", "city_code", "city_name", "keywords", "created_at", "updated_at", "metadata"],
      "required": ["name", "vehicle_type", "city_code", "source_system", "source_id"],
      "indexes": ["vehicle_type", "city_code", "sticker_status"]
    },
    {
      "id": "Vehicle",
      "label": "车辆",
      "kind": "vehicle",
      "description": "司机绑定的车辆，承载车型与车贴状态。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "plate_no", "vehicle_type", "sticker_status", "driver_id", "city_code", "keywords", "created_at", "updated_at", "metadata"],
      "required": ["name", "plate_no", "vehicle_type", "source_system", "source_id"],
      "indexes": ["vehicle_type", "sticker_status", "city_code"]
    },
    {
      "id": "City",
      "label": "城市",
      "kind": "city",
      "description": "业务开城单元，区分托管城市与非托管城市。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "city_code", "city_name", "managed", "region", "created_at", "updated_at", "metadata"],
      "required": ["name", "city_code", "source_system", "source_id"],
      "indexes": ["city_code", "managed", "region"]
    },
    {
      "id": "Order",
      "label": "订单",
      "kind": "order",
      "description": "业务订单主体，用于验证人群规则命中的真实业务对象。",
      "properties": ["name", "display_name", "description", "status", "owner", "domain", "source_system", "source_id", "source_url", "order_id", "driver_id", "city_code", "vehicle_type", "amount", "created_at", "updated_at", "metadata"],
      "required": ["name", "order_id", "city_code", "source_system", "source_id"],
      "indexes": ["order_id", "city_code", "driver_id"]
    }
  ],
  "relations": [

  "state_machines": {
    "Crowd": {
      "initial": "DRAFT",
      "states": ["DRAFT", "ACTIVE", "PAUSED", "ARCHIVED"],
      "transitions": {
        "DRAFT": ["ACTIVE", "ARCHIVED"],
        "ACTIVE": ["PAUSED", "ARCHIVED"],
        "PAUSED": ["ACTIVE", "ARCHIVED"],
        "ARCHIVED": []
      }
    },
    "Strategy": {
      "initial": "DRAFT",
      "states": ["DRAFT", "REVIEW", "ACTIVE", "PAUSED", "ARCHIVED"],
      "transitions": {
        "DRAFT": ["REVIEW", "ARCHIVED"],
        "REVIEW": ["ACTIVE", "DRAFT", "ARCHIVED"],
        "ACTIVE": ["PAUSED", "ARCHIVED"],
        "PAUSED": ["ACTIVE", "ARCHIVED"],
        "ARCHIVED": []
      }
    },
    "CanvasTask": {
      "initial": "DRAFT",
      "states": ["DRAFT", "SCHEDULED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"],
      "transitions": {
        "DRAFT": ["SCHEDULED", "CANCELLED"],
        "SCHEDULED": ["RUNNING", "CANCELLED"],
        "RUNNING": ["COMPLETED", "FAILED"],
        "FAILED": ["SCHEDULED", "CANCELLED"],
        "COMPLETED": [],
        "CANCELLED": []
      }
    }
  },
  "constraints": [
    {
      "id": "C1",
      "label": "全局资产 ID 规范",
      "type": "id_format",
      "target": "ALL",
      "severity": "ERROR",
      "message": "资产 ID 必须符合 {kind}:{source_system}:{source_id}。"
    },
    {
      "id": "C2",
      "label": "资产必填属性",
      "type": "required_properties",
      "target": "ALL",
      "severity": "ERROR",
      "message": "每类资产必须满足该类 required 字段。"
    },
    {
      "id": "C3",
      "label": "状态机合法迁移",
      "type": "state_transition",
      "target": "Crowd,Strategy,CanvasTask",
      "severity": "ERROR",
      "message": "资产状态只能沿 state_machines 中定义的边迁移。"
    },
    {
      "id": "C4",
      "label": "时态边必须有时效起点",
      "type": "temporal_edge",
      "target": "ALL_EDGES",
      "severity": "ERROR",
      "message": "所有语义边必须提供 valid_from，且 valid_to 不得早于 valid_from。"
    },
    {
      "id": "C5",
      "label": "关系定义域/值域",
      "type": "relation_domain_range",
      "target": "ALL_EDGES",
      "severity": "ERROR",
      "message": "边两端顶点类型必须符合关系定义。"
    },
    {
      "id": "C6",
      "label": "禁止自派生",
      "type": "forbid_self",
      "target": "crowd_derived_from",
      "severity": "ERROR",
      "message": "人群不能从自身派生。"
    },
    {
      "id": "C7",
      "label": "人群必须有标签",
      "type": "min_relation",
      "target": "Crowd.crowd_has_tag",
      "severity": "ERROR",
      "min": 1,
      "message": "可用于投放的人群至少需要一个标签定义。"
    },
    {
      "id": "C8",
      "label": "发布资产必须有证据",
      "type": "min_relation",
      "target": "Crowd.asset_has_evidence",
      "severity": "ERROR",
      "min": 1,
      "message": "对外发布的人群、策略必须至少关联一条证据。"
    },
    {
      "id": "C9",
      "label": "版本必须可追溯操作人",
      "type": "min_relation",
      "target": "Version.version_generated_by",
      "severity": "ERROR",
      "min": 1,
      "message": "每个版本必须记录生成操作人。"
    },
    {
      "id": "C10",
      "label": "证据必须包含来源与观测时间",
      "type": "required_properties",
      "target": "Evidence",
      "severity": "ERROR",
      "message": "证据必须包含 source_system 与 observed_at。"
    },
    {
      "id": "C11",
      "label": "策略发布必须有生效窗口",
      "type": "required_properties",
      "target": "Strategy",
      "severity": "WARN",
      "message": "ACTIVE 策略建议提供 effective_from / effective_to。"
    },
    {
      "id": "C12",
      "label": "画像资产权限边界",
      "type": "required_properties",
      "target": "Crowd",
      "severity": "WARN",
      "message": "人群建议声明 permission_scope，避免跨域越权使用。"
    },
    {
      "id": "C13",
      "label": "人群圈选规则必须可解析",
      "type": "rule_parseable",
      "target": "Crowd",
      "severity": "ERROR",
      "message": "人群必须提供可解析的 rule_expression，否则无法判断是否圈错。"
    },
    {
      "id": "C14",
      "label": "人群名称/描述与圈选规则语义一致",
      "type": "semantic_consistency",
      "target": "Crowd",
      "severity": "ERROR",

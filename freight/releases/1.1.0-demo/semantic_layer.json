      "key": "driver_id",
      "description": "实际承运人，接单、到场、装货、送达动作的发起者。",
      "statuses": [
        "IDLE",
        "ASSIGNED",
        "ON_TRIP",
        "OFFLINE"
      ],
      "properties": [
        "driver_id",
        "driver_name",
        "fleet",
        "qualification",
        "status"
      ]
    },
    {
      "id": "Vehicle",
      "label": "车辆",
      "key": "vehicle_id",
      "description": "运力的物理载体，车型与载重决定可承接范围。",
      "statuses": [
        "IDLE",
        "IN_USE",
        "MAINTENANCE"
      ],
      "properties": [
        "vehicle_id",
        "plate",
        "vehicle_type",
        "capacity_t",
        "fleet",
        "status"
      ]
    },
    {
      "id": "FeeItem",
      "label": "费用项",
      "key": "fee_id",
      "description": "运单产生的每一笔费用，保留计费依据、来源与时间。",
      "statuses": [
        "NORMAL",
        "DISPUTED",
        "WAIVED"
      ],
      "properties": [
        "fee_id",
        "fee_type",
        "fee_label",
        "quoted_amount",
        "expected_amount",
        "actual_amount",
        "waived_amount",
        "calc_basis",
        "occurred_at",
        "source_system",
        "status"
      ]
    },
    {
      "id": "Settlement",
      "label": "结算单",
      "key": "settlement_id",
      "description": "按周期汇总费用项形成应收应付；已入账后只能冲正。",
      "statuses": [
        "DRAFT",
        "PENDING",
        "POSTED",
        "ON_HOLD",
        "REVERSED"
      ],
      "properties": [
        "settlement_id",
        "period",
        "amount",
        "reversed_amount",
        "status",
        "posted_at"
      ]
    },
    {
      "id": "Invoice",
      "label": "发票",
      "key": "invoice_id",
      "description": "开给货主的税务凭证，金额必须与结算单一致。",
      "statuses": [
        "DRAFT",
        "ISSUED",
        "VOIDED"
      ],
      "properties": [
        "invoice_id",
        "invoice_no",
        "title",
        "amount",
        "tax_rate",
        "status",
        "issued_at"
      ]
    },
    {
      "id": "ExceptionTicket",
      "label": "异常工单",
      "key": "ticket_id",
      "description": "把履约异常收口为可跟踪、可分派、可关闭的工单。",
      "statuses": [
        "OPEN",
        "PROCESSING",
        "CLOSED"
      ],
      "properties": [
        "ticket_id",
        "ticket_type",
        "reason",
        "assignee",
        "status",
        "resolution",
        "opened_at",
        "closed_at"
      ]
    },
    {
      "id": "Evidence",
      "label": "证据",
      "key": "evidence_id",
      "description": "来自源系统、带时间戳和版本号的可核对事实。",
      "statuses": [
        "VALID",
        "VOID"
      ],
      "properties": [
        "evidence_id",
        "evidence_type",
        "source_system",
        "occurred_at",
        "version",
        "summary",
        "checksum",
        "status"
      ]
    }
  ],

      "system": "计价中心",
      "tool": "pricing.get_quote",
      "key": "quote_id",
      "description": "按订单读取报价单与当前生效版本。"
    },
    {
      "class": "QuoteItem",
      "system": "计价中心",
      "tool": "pricing.list_quote_items",
      "key": "quote_item_id",
      "description": "按报价单读取逐项报价明细与规则版本。"
    },
    {
      "class": "PricingRule",
      "system": "计价中心",
      "tool": "pricing.get_rule",
      "key": "rule_id",
      "description": "按费用类型、城市、车型与时间读取生效的定价规则版本。"
    },
    {
      "class": "Track",
      "system": "轨迹平台",
      "tool": "track.get_track",
      "key": "track_id",
      "description": "按运单读取轨迹摘要、里程与时长；GPS 点位另行按需查询。"
    },
    {
      "class": "Cargo",
      "system": "TMS",
      "tool": "tms.get_cargo",
      "key": "cargo_id",
      "description": "按订单读取货物重量、体积、件数与包装信息。"
    }
  ],
  "relation_source": {
    "system": "图查询 / MCP",
    "tool": "graph.list_relations",
    "description": "关系实例按主语、谓语与方向实时查询；本体只保存关系定义。"
  },
  "rules": [
    {
      "id": "R-WAIT-01",
      "name": "等候费计算规则",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "waiting"
          }
        ]
      },
      "judge": {
        "formula": "ceil(max(0, waiting_minutes - free_minutes[vehicle_type]) / block_minutes[vehicle_type]) * per_block[vehicle_type]",
        "explain": "等候费按车型取不同费率；本次演示把 4.2 米厢货从每 5 分钟 2.4 元调整为 3.0 元。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-HIGHWAY-01",
      "name": "高速费据实结算",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "highway"
          }
        ]
      },
      "judge": {
        "formula": "以 ETC 扣费记录为准",
        "explain": "高速费必须有 ETC 扣费记录作为证据，不能手工估算。",
        "severity": "MEDIUM"
      }
    },
    {
      "id": "R-WAYBILL-01",
      "name": "装货后不可改派",
      "domain": "Waybill",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "in",
            "value": [
              "LOADED",
              "DELIVERED"
            ]
          }
        ]
      },
      "judge": {
        "forbidden_actions": [
          "reassign_waybill"
        ],
        "explain": "货物已装车后改派会破坏履约连续性；只能走异常工单流程。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-SETTLE-01",
      "name": "已入账只能冲正",
      "domain": "Settlement",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "eq",
            "value": "POSTED"
          }
        ]
      },
      "judge": {
        "forbidden_actions": [
          "hold_settlement"
        ],
        "allowed_actions": [
          "reverse_entry"
        ],
        "explain": "结算单已入账后不能直接改数或挂起，只能通过冲正留下调整痕迹。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-INVOICE-01",
      "name": "发票金额同步结算单",
      "domain": "Invoice",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "in",
            "value": [
              "DRAFT",
              "ISSUED"
            ]
          }
        ]
      },
      "judge": {
        "formula": "invoice.amount == settlement.amount",
        "explain": "发票金额必须与结算单一致；结算冲正后发票需同步红冲。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-BASE-01",
      "name": "基础运费按车型锁定",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "base"
          }
        ]
      },
      "judge": {
        "formula": "base_fee.actual_amount == pricing_rule.params.base_fare_by_vehicle_type[vehicle_type]",
        "explain": "基础运费按报价时车型对应的价格锁定，不随履约过程变化。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-MILEAGE-01",
      "name": "里程费按实际轨迹计价",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "mileage"
          }
        ]
      },
      "judge": {
        "formula": "mileage_fee.actual_amount == track.distance_km * pricing_rule.params.per_km",
        "explain": "里程费以有效轨迹里程乘以单价计算，预估里程不能直接作为结算依据。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-LOADING-01",
      "name": "装卸费按订单锁定",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "loading"
          }
        ]
      },
      "judge": {
        "formula": "loading_fee.actual_amount == pricing_rule.params.per_order",
        "explain": "装卸费按订单一次性收取，报价中已包含的不得在履约后重复加价。",
        "severity": "MEDIUM"
      }
    },
    {
      "id": "R-INSURANCE-01",
      "name": "保险服务费按订单锁定",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "insurance"
          }
        ]
      },
      "judge": {
        "formula": "insurance_fee.actual_amount == pricing_rule.params.per_order",
        "explain": "保险服务费按订单固定金额收取，需与报价明细一致。",
        "severity": "MEDIUM"
      }
    },
    {
      "id": "R-OTHER-01",
      "name": "其他费用不得超出报价",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "other"
          }
        ]
      },
      "judge": {
        "formula": "other_fee.actual_amount <= quote_item.amount",
        "explain": "其他费用必须有报价明细支撑，且不得超过报价金额。",
        "severity": "MEDIUM"
      }
    },
    {
      "id": "R-QUOTE-01",
      "name": "报价合计等于明细之和",
      "domain": "Quote",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "in",
            "value": [
              "ACTIVE",
              "SUPERSEDED"
            ]
          }
        ]
      },
      "judge": {
        "formula": "quote.total_amount == sum(quote_item.amount)",
        "explain": "报价单总价必须等于全部有效报价明细之和，否则后续差额无法归因。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-PRICE-01",
      "name": "费用必须引用生效期内的定价版本",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "ne",
            "value": "WAIVED"
          }
        ]
      },
      "judge": {
        "formula": "pricing_rule.effective_from <= fee.occurred_at <= pricing_rule.effective_to",
        "explain": "每笔费用都要能追溯到费用发生时生效的定价规则版本，跨版本计价必须留痕。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-TRACK-01",
      "name": "计费里程以轨迹为准",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "mileage"
          }
        ]
      },
      "judge": {
        "formula": "abs(track.distance_km - fee.calc_basis.distance_km) <= 0.1",
        "explain": "里程费引用的里程必须与有效轨迹记录一致，偏差超过 0.1km 需人工复核。",
        "severity": "HIGH"
      }
    }
  ],
  "actions": [

    "driver_id": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "order_id": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "city_code": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "city_name": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "managed": {"data_type": "BOOLEAN", "cardinality": "SINGLE"},
    "region": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "amount": {"data_type": "DOUBLE", "cardinality": "SINGLE"},
    "action": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "trigger_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "channel": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "risk_level": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "canvas_id": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "canvas_name": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "task_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "schedule": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "audience_rule": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "publish_channel": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "last_run_at": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "next_run_at": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "result": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "error_message": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "version": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "previous_version": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "change_summary": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "evidence_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "content": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "observed_at": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "operator_name": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "role": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "account": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "email": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "confirmed_by": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "confirmed_at": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "payload": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "ttl_days": {"data_type": "INT", "cardinality": "SINGLE"},
    "estimated_size": {"data_type": "LONG", "cardinality": "SINGLE"},
    "target_size": {"data_type": "LONG", "cardinality": "SINGLE"},
    "score": {"data_type": "DOUBLE", "cardinality": "SINGLE"},
    "weight": {"data_type": "DOUBLE", "cardinality": "SINGLE"},
    "is_active": {"data_type": "BOOLEAN", "cardinality": "SINGLE"},
    "priority": {"data_type": "INT", "cardinality": "SINGLE"},
    "permission_scope": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "effective_from": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "effective_to": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "keywords": {"data_type": "TEXT", "cardinality": "LIST"},
    "tags": {"data_type": "TEXT", "cardinality": "LIST"},
    "metadata": {"data_type": "TEXT", "cardinality": "SINGLE"}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judgment",
  "description": "规则或约束作用于对象后的结构化判断。契约见 plan/judgment-proposal-contract.md 第 2 节。",
  "type": "object",
  "required": [
    "judgment_id",
    "subject",
    "as_of",
    "verdict",
    "summary",
    "reason",
    "evidence",
    "ontology_version",
    "produced_at"
  ],
  "properties": {
    "judgment_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": ["type", "object_id"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNKNOWN"]
    },
    "rule_id": {
      "type": ["string", "null"]
    },
    "severity": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref", "detail"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["fact", "rule", "constraint", "derivation"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unknown_reason": {
      "type": ["string", "null"]
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "const": "UNKNOWN" }
        },
        "required": ["verdict"]
      },
      "then": {
        "required": ["unknown_reason"],
        "properties": {
          "unknown_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "FAIL" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "reason": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
    {
      "id": "C15",
      "label": "人群城市范围与声明覆盖一致",
      "type": "scope_coverage",
      "target": "Crowd",
      "severity": "ERROR",
      "message": "人群声明的城市数量必须与规则中的城市范围一致，托管城市不得漏配。"
    }
  ],
  "context_projection": {
    "OVERVIEW": ["id", "label", "name", "display_name", "status", "owner", "description", "updated_at"],
    "NETWORK": ["id", "label", "name", "display_name", "status", "owner", "description", "updated_at", "neighbors"],
    "FULL": ["id", "label", "name", "display_name", "status", "owner", "description", "updated_at", "properties", "neighbors", "evidence", "versions", "metrics", "lineage"]
  },
  "write_gate": {
    "policy": "所有修改人群、标签、策略、画布的动作必须经过 Agent 提议 -> 人工确认 -> 执行 -> 审计留痕。",
    "allowed_actions": ["update_status", "attach_tag", "attach_evidence", "publish_strategy", "update_properties"],
    "forbidden": ["直接删除资产", "绕过源系统权限发布", "无审计的批量改写"]
  }
}
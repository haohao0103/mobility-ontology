{
  "meta": {
    "name": "画像 AI 资产语义层",
    "version": "1.1.0",
    "description": "面向画像 AI Agent 的人群/标签/策略/画布/指标/证据/版本/操作人语义层，并内置司机/车辆/城市/订单业务主体层，支撑 P0 人群智能纠错。",
    "graphspace": "profile_ai",
    "graph": "profile",
    "id_pattern": "^(crowd|tag|strategy|canvas|metric|evidence|version|operator|driver|vehicle|city|order):[a-z0-9][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "id_description": "全局资产 ID 统一为 {kind}:{source_system}:{source_id}，保证 HugeGraph / DataHub / OpenSearch 实体对齐。"
  },
  "id_rules": {
    "kinds": {
      "crowd": {"class": "Crowd", "label": "人群"},
      "tag": {"class": "Tag", "label": "标签"},
      "strategy": {"class": "Strategy", "label": "策略"},
      "canvas": {"class": "CanvasTask", "label": "画布任务"},
      "metric": {"class": "Metric", "label": "指标"},
      "evidence": {"class": "Evidence", "label": "证据"},
      "version": {"class": "Version", "label": "版本"},
      "operator": {"class": "Operator", "label": "操作人"},
      "driver": {"class": "Driver", "label": "司机"},
      "vehicle": {"class": "Vehicle", "label": "车辆"},
      "city": {"class": "City", "label": "城市"},
      "order": {"class": "Order", "label": "订单"}
    }
  },
  "properties": {
    "name": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "display_name": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "description": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "status": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "status_reason": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "owner": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "domain": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "source_system": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "source_id": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "source_url": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "asset_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "created_at": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "updated_at": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "valid_from": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "valid_to": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "confidence": {"data_type": "DOUBLE", "cardinality": "SINGLE"},
    "definition": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "expression": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "metric_id": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "metric_name": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "value": {"data_type": "DOUBLE", "cardinality": "SINGLE"},
    "value_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "unit": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "period": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "direction": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "sample_size": {"data_type": "LONG", "cardinality": "SINGLE"},
    "rule": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "rule_expression": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "rule_language": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "rule_parseable": {"data_type": "BOOLEAN", "cardinality": "SINGLE"},
    "referenced_tags": {"data_type": "TEXT", "cardinality": "LIST"},
    "scope": {"data_type": "TEXT", "cardinality": "LIST"},
    "crowd_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "expected_city_count": {"data_type": "INT", "cardinality": "SINGLE"},
    "vehicle_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "sticker_status": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "intent_vehicle_type": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "intent_sticker_status": {"data_type": "TEXT", "cardinality": "SINGLE"},
    "intent_expected_city_count": {"data_type": "INT", "cardinality": "SINGLE"},
    "intent_managed_cities": {"data_type": "TEXT", "cardinality": "LIST"},

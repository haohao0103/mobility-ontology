  "functions": [
    {
      "id": "fee_breakdown",
      "label": "费用拆解",
      "target": "Waybill",
      "implementation": "fee_analysis",
      "description": "确定性拆解运单的报价、规则应计、实收、减免和差异，并给出等候费规则公式与证据。",
      "params": [
        {
          "name": "waybill_id",
          "label": "运单对象 ID",
          "type": "string",
          "required": true
        }
      ],
      "returns": "FeeBreakdown"
    },
    {
      "id": "quote_reconcile",
      "label": "报价对账",
      "target": "Waybill",
      "implementation": "quote_reconcile",
      "description": "确定性对比订单报价明细与实际费用，找出报价未包含、金额不一致的费用类型，不依赖模型拼查询。",
      "params": [
        {
          "name": "waybill_id",
          "label": "运单对象 ID",
          "type": "string",
          "required": true
        }
      ],
      "returns": "QuoteReconcile"
    },
    {
      "id": "evidence_chain",
      "label": "证据链",
      "target": "Waybill",
      "implementation": "evidence_chain",
      "description": "确定性汇总运单、费用项及其关联对象的证据和事件，返回可核对的证据链与缺口。",
      "params": [
        {
          "name": "waybill_id",
          "label": "运单对象 ID",
          "type": "string",
          "required": true
        }
      ],
      "returns": "EvidenceChain"
    },
    {
      "id": "action_preflight",
      "label": "动作预检",
      "target": "Waybill",
      "implementation": "action_preflight",
      "description": "确定性预检运单当前可用和被阻止的动作、规则阻断原因和影响面，不执行任何写回。",
      "params": [
        {
          "name": "object_id",
          "label": "运单对象 ID",
          "type": "string",
          "required": true
        },
        {
          "name": "action_id",
          "label": "动作 ID（可选）",
          "type": "string",
          "required": false
        }
      ],
      "returns": "ActionPreflight"
    }

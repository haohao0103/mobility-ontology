{
  "meta": {
    "name": "货拉拉订单本体 · 可执行语义层",
    "version": "1.3.1-demo",
    "scope": "从货主下单、报价生成、订单生成运单、司机承运、费用产生、轨迹留证、结算开票到异常处理",
    "note": "本体只持久化类、关系、规则、动作与数据源映射；业务事实经 MCP / API 按需查询，不写入本体库。",
    "storage_policy": "knowledge-only",
    "based_on": "1.3.0",
    "released_at": "2026-11-19T11:32:32+08:00"
  },
  "classes": [
    {
      "id": "Shipper",
      "label": "货主",
      "key": "shipper_id",
      "description": "下运输需求、承担结算责任的主体。",
      "statuses": [
        "ACTIVE",
        "DISABLED"
      ],
      "properties": [
        "shipper_id",
        "shipper_name",
        "settlement_subject",
        "contact",
        "status"
      ]
    },
    {
      "id": "Order",
      "label": "订单",
      "key": "order_id",
      "description": "货主发起的一次运输需求，是需求口径。",
      "statuses": [
        "CREATED",
        "DISPATCHED",
        "CANCELLED",
        "COMPLETED"
      ],
      "properties": [
        "order_id",
        "shipper_id",
        "origin",
        "destination",
        "cargo",
        "vehicle_type",
        "estimated_fee",
        "created_at",
        "status"
      ]
    },
    {
      "id": "Waybill",
      "label": "运单",
      "key": "waybill_id",
      "description": "履约主体，整条链路唯一的业务主键，费用、结算、异常最终都挂到它身上。",
      "statuses": [
        "CREATED",
        "ACCEPTED",
        "REASSIGNED",
        "LOADED",
        "DELIVERED"
      ],
      "properties": [
        "waybill_id",
        "order_id",
        "driver_id",
        "vehicle_id",
        "status",
        "estimated_fee",
        "actual_fee",
        "variance",
        "waiting_minutes",
        "free_wait_minutes",
        "accepted_at",
        "arrival_at",
        "loading_started_at",
        "loading_ended_at",
        "loading_confirmed_at",
        "unloading_started_at",
        "unloading_ended_at",
        "delivered_at",
        "actual_distance_km",
        "actual_duration_min",
        "proof_of_delivery"
      ]
    },
    {
      "id": "Driver",
      "label": "司机",
      "key": "driver_id",
      "description": "实际承运人，接单、到场、装货、送达动作的发起者。",
      "statuses": [
        "IDLE",
        "ASSIGNED",
        "ON_TRIP",
        "OFFLINE"
      ],
      "properties": [
        "driver_id",
        "driver_name",
        "fleet",
        "qualification",
        "status"
      ]
    },
    {
      "id": "Vehicle",
      "label": "车辆",
      "key": "vehicle_id",
      "description": "运力的物理载体，车型与载重决定可承接范围。",
      "statuses": [
        "IDLE",
        "IN_USE",
        "MAINTENANCE"
      ],
      "properties": [
        "vehicle_id",
        "plate",
        "vehicle_type",
        "capacity_t",
        "fleet",
        "status"
      ]
    },
    {
      "id": "FeeItem",
      "label": "费用项",
      "key": "fee_id",
      "description": "运单产生的每一笔费用，保留计费依据、来源与时间。",
      "statuses": [
        "NORMAL",
        "DISPUTED",
        "WAIVED"
      ],
      "properties": [
        "fee_id",
        "fee_type",
        "fee_label",
        "quoted_amount",
        "expected_amount",
        "actual_amount",
        "waived_amount",
        "calc_basis",
        "pricing_rule_id",
        "pricing_rule_version",
        "occurred_at",
        "source_system",
        "status"
      ]
    },
    {
      "id": "Settlement",
      "label": "结算单",
      "key": "settlement_id",
      "description": "按周期汇总费用项形成应收应付；已入账后只能冲正。",
      "statuses": [
        "DRAFT",
        "PENDING",
        "POSTED",
        "ON_HOLD",
        "REVERSED"
      ],
      "properties": [
        "settlement_id",
        "period",
        "amount",
        "reversed_amount",
        "status",
        "posted_at"
      ]
    },
    {
      "id": "Invoice",
      "label": "发票",
      "key": "invoice_id",
      "description": "开给货主的税务凭证，金额必须与结算单一致。",
      "statuses": [
        "DRAFT",
        "ISSUED",
        "VOIDED"
      ],
      "properties": [
        "invoice_id",
        "invoice_no",
        "title",
        "amount",
        "tax_rate",
        "status",
        "issued_at"
      ]
    },
    {
      "id": "ExceptionTicket",
      "label": "异常工单",
      "key": "ticket_id",
      "description": "把履约异常收口为可跟踪、可分派、可关闭的工单。",
      "statuses": [
        "OPEN",
        "PROCESSING",
        "CLOSED"
      ],
      "properties": [
        "ticket_id",
        "ticket_type",
        "reason",
        "assignee",
        "status",
        "resolution",
        "opened_at",
        "closed_at"
      ]
    },
    {
      "id": "Evidence",
      "label": "证据",
      "key": "evidence_id",
      "description": "来自源系统、带时间戳和版本号的可核对事实。",
      "statuses": [
        "VALID",
        "VOID"
      ],
      "properties": [
        "evidence_id",
        "evidence_type",
        "source_system",
        "occurred_at",
        "version",
        "summary",
        "checksum",
        "status"
      ]
    },
    {
      "id": "Quote",
      "label": "报价单",
      "key": "quote_id",
      "description": "下单时形成的价格快照，记录报价总价、有效期与定价规则版本；同一订单可多版本，ACTIVE 版本是费用对账基线。",
      "statuses": [
        "DRAFT",
        "ACTIVE",
        "SUPERSEDED",
        "EXPIRED",
        "VOID"
      ],
      "properties": [
        "quote_id",
        "order_id",
        "version",
        "quoted_at",
        "valid_until",
        "total_amount",
        "currency",
        "pricing_rule_version",
        "status"
      ]
    },
    {
      "id": "QuoteItem",
      "label": "报价明细",
      "key": "quote_item_id",
      "description": "报价单中的单项费用，保留费用类型、金额与定价规则版本，用于与实际费用项逐项对账。",
      "statuses": [
        "NORMAL",
        "VOID"
      ],
      "properties": [
        "quote_item_id",
        "quote_id",
        "fee_type",
        "fee_label",
        "amount",
        "quantity",
        "unit",
        "calc_rule_id",
        "pricing_rule_version",
        "status"
      ]
    },
    {
      "id": "PricingRule",
      "label": "定价规则版本",
      "key": "rule_id",
      "description": "某城市、车型、费用类型在生效期内的费率版本；费用项与报价项都必须能追溯到当时生效的规则版本。",
      "statuses": [
        "DRAFT",
        "ACTIVE",
        "EXPIRED"
      ],
      "properties": [
        "rule_id",
        "fee_type",
        "city",
        "vehicle_type",
        "effective_from",
        "effective_to",
        "version",
        "currency",
        "params",
        "source_system",
        "status"
      ]
    },
    {
      "id": "Track",
      "label": "轨迹记录",
      "key": "track_id",
      "description": "一次履约的轨迹与里程证据索引，只保留起止时间、里程、时长与来源；GPS 点位由轨迹平台按需查询，不写入本体库。",
      "statuses": [
        "VALID",
        "VOID"
      ],
      "properties": [
        "track_id",
        "waybill_id",
        "source_system",
        "started_at",
        "ended_at",
        "distance_km",
        "duration_min",
        "waiting_minutes",
        "point_count",
        "checksum",
        "status"
      ]
    },
    {
      "id": "Cargo",
      "label": "货物",
      "key": "cargo_id",
      "description": "运输标的，记录重量、体积、件数与包装，是车型匹配、装载与加价项判断的依据。",
      "statuses": [
        "NORMAL",
        "DAMAGED"
      ],
      "properties": [
        "cargo_id",
        "name",
        "weight_kg",
        "volume_m3",
        "package_count",
        "package_type",
        "status"
      ]
    }
  ],

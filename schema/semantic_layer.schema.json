{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobility-ontology.local/schema/semantic_layer.schema.json",
  "title": "Freight Semantic Layer",
  "description": "Freight 运行时本体知识文档的元模型契约。canonical 仍是 JSON DSL；本 schema 只校验结构与字段类型，不校验跨引用完整性（由 scripts/semantic_gate.py 负责）。根目录 semantic_layer.json 是 mobility core 演示本体，另行演进。",
  "type": "object",
  "required": ["meta", "classes", "relations"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/class" }
    },
    "object_type_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_type_group" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "catalog": { "$ref": "#/$defs/catalog" },
    "closure": { "$ref": "#/$defs/closure" },
    "diagnosis": { "$ref": "#/$defs/diagnosis" },
    "pricing": { "$ref": "#/$defs/pricing" },
    "primitives": {
      "type": "array",
      "items": { "$ref": "#/$defs/primitive" }
    },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    },
    "data_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/data_source" }
    },
    "relation_source": { "$ref": "#/$defs/relation_source" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "meta": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "note": { "type": "string" },
        "based_on": { "type": "string" },
        "released_at": { "type": "string" },
        "storage_policy": {
          "type": "string",
          "enum": ["knowledge-only", "projection", "hybrid"]
        }
      }
    },
    "class": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/typeId" },
        "label": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "aliases": { "$ref": "#/$defs/stringArray" },
        "statuses": { "$ref": "#/$defs/stringArray" },
        "properties": { "$ref": "#/$defs/stringArray" },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "iri": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string", "minLength": 1 }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "domain", "range"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/relationId" },
        "label": { "type": "string" },
        "domain": { "$ref": "#/$defs/typeId" },
        "range": { "$ref": "#/$defs/typeId" },
        "temporal": { "type": "boolean" },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "iri": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string", "minLength": 1 }
      }
    },
    "object_type_group": {
      "type": "object",
      "required": ["id", "label", "types"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/relationId" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "aliases": { "$ref": "#/$defs/stringArray" },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeId" },
          "minItems": 1
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": ["mode", "context_budget_chars"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["full_if_fits", "always_group", "always_full"] },
        "context_budget_chars": { "type": "integer", "minimum": 500 },
        "description_max_chars": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "closure": {
      "type": "object",
      "required": ["mode", "relations"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string" },
        "max_depth": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["in", "out", "both"]
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["seed_type", "required_relations"],
      "additionalProperties": false,
      "properties": {
        "seed_type": { "$ref": "#/$defs/typeId" },
        "required_relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationId" }
        },
        "claim": { "type": "string" }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rule_id"],
        "additionalProperties": true,
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "primitive": {
      "type": "object",
      "required": ["name", "description", "arguments", "required", "returns"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "system": { "type": "string" },
        "description": { "type": "string" },
        "arguments": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "required": { "$ref": "#/$defs/stringArray" },
        "returns": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "required": ["id", "label", "target", "implementation", "params", "returns"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/relationId" },
        "label": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/typeId" },
        "implementation": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" }
        },
        "returns": { "type": "string", "minLength": 1 }
      }
    },
    "data_source": {
      "type": "object",
      "required": ["class", "system", "tool", "key"],
      "additionalProperties": false,
      "properties": {
        "class": { "$ref": "#/$defs/typeId" },
        "system": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "relation_source": {
      "type": "object",
      "required": ["system", "tool"],
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string" },
        "tool": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "name", "domain", "when", "judge"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^R-[A-Z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/typeId" },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "iri": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string", "minLength": 1 },
        "when": {
          "type": "object",
          "description": "规则前置条件表达式；当前允许 all/any 等自由结构，G1-03 迁移为 AST。",
          "additionalProperties": true
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "formula": { "type": "string" },
            "ast": { "type": "object" },
            "calc": {
              "type": "object",
              "additionalProperties": true
            },
            "compute": {
              "type": "object",
              "additionalProperties": true
            },
            "allowed_actions": { "$ref": "#/$defs/stringArray" },
            "forbidden_actions": { "$ref": "#/$defs/stringArray" },
            "explain": { "type": "string" },
            "severity": {
              "type": "string",
              "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
            }
          },
          "anyOf": [
            { "required": ["formula"] },
            { "required": ["ast"] },
            { "required": ["allowed_actions"] },
            { "required": ["forbidden_actions"] }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "label", "target", "roles", "from_status", "to_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/relationId" },
        "label": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/typeId" },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "iri": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string", "minLength": 1 },
        "roles": { "$ref": "#/$defs/stringArray" },
        "from_status": { "$ref": "#/$defs/stringArray" },
        "to_status": { "type": "string", "minLength": 1 },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" }
        },
        "description": { "type": "string" }
      }
    },
    "param": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "typeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "relationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
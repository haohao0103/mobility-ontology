{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObjectSetQuery",
  "description": "组合式 Object Set 查询树（E1 谓词 / E2 集合代数 / E3 管道）。LLM 与前端按此约束生成查询；本体期校验（freight/object_query.py）在此之上做属性/类型/算子白名单校验。",
  "type": "object",
  "required": ["set"],
  "properties": {
    "set": { "$ref": "#/definitions/setExpr" },
    "where": { "$ref": "#/definitions/predicate" },
    "orderBy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prop"],
        "properties": {
          "prop": { "type": "string" },
          "dir": { "enum": ["asc", "desc"] }
        },
        "additionalProperties": false
      }
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "count": { "type": "boolean" },
        "sum": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "avg": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "min": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "max": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "group_by": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["count"] }, { "required": ["sum"] }, { "required": ["avg"] },
        { "required": ["min"] }, { "required": ["max"] }, { "required": ["group_by"] }
      ]
    },
    "page": {
      "type": "object",
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
        "offset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "setExpr": {
      "type": "object",
      "anyOf": [
        { "required": ["from"] },
        { "required": ["ids"] },
        { "required": ["followLink"] },
        { "required": ["union"] },
        { "required": ["intersect"] },
        { "required": ["subtract"] },
        { "required": ["symmetric_difference"] },
        { "required": ["product"] },
        { "required": ["pivot"] },
        { "required": ["join"] },
        { "required": ["fromView"] },
        { "required": ["geo"] }
      ],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "where": { "$ref": "#/definitions/predicate" },
        "followLink": {
          "type": "object",
          "required": ["set", "link"],
          "properties": {
            "set": { "$ref": "#/definitions/setExpr" },
            "link": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["out", "in"] },
            "at": { "type": "string", "minLength": 1, "description": "时态回放：只取该时刻活跃的关系（E6）" }
          },
          "additionalProperties": false
        },
        "union": {
          "type": "array", "minItems": 2,
          "items": { "$ref": "#/definitions/setExpr" }
        },
        "intersect": {
          "type": "array", "minItems": 2,
          "items": { "$ref": "#/definitions/setExpr" }
        },
        "subtract": {
          "type": "object",
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/definitions/setExpr" },
            "right": { "$ref": "#/definitions/setExpr" }
          },
          "additionalProperties": false
        },
        "symmetric_difference": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/definitions/setExpr" }
        },
        "product": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/definitions/setExpr" }
        },
        "pivot": {
          "type": "object",
          "required": ["set", "byLink"],
          "properties": {
            "set": { "$ref": "#/definitions/setExpr" },
            "byLink": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["out", "in"] }
          },
          "additionalProperties": false
        },
        "join": {
          "type": "object",
          "required": ["left", "right", "on"],
          "properties": {
            "left": { "$ref": "#/definitions/setExpr" },
            "right": { "$ref": "#/definitions/setExpr" },
            "on": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["left", "right"],
                "properties": {
                  "left": { "type": "string" }, "right": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "type": { "enum": ["inner", "left"] }
          },
          "additionalProperties": false
        },
        "fromView": { "type": "string", "minLength": 1 },
        "geo": {
          "type": "object",
          "required": ["lat0", "lon0", "lat1", "lon1"],
          "properties": {
            "lat0": { "type": "number" }, "lon0": { "type": "number" },
            "lat1": { "type": "number" }, "lon1": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "$and": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } },
        "$or": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } },
        "$not": { "$ref": "#/definitions/predicate" }
      },
      "patternProperties": {
        "^[^$].*$": { "$ref": "#/definitions/opSpec" }
      },
      "additionalProperties": false
    },
    "opSpec": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null", "array"] },
        {
          "type": "object",
          "patternProperties": {
            "^\\$(eq|neq|gt|gte|lt|lte|in|nin|contains|startswith|endswith|exists)$": {}
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    }
  }
}

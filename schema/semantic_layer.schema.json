{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobility-ontology.local/schema/semantic_layer.schema.json",
  "title": "Freight Semantic Layer",
  "description": "Freight 运行时本体知识文档的元模型契约。canonical 仍是 JSON DSL；本 schema 只校验结构与字段类型，不校验跨引用完整性（由 scripts/semantic_gate.py 负责）。根目录 semantic_layer.json 是 mobility core 演示本体，另行演进。",
  "type": "object",
  "required": [
    "meta",
    "classes",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "object_type_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_type_group"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "closure": {
      "$ref": "#/$defs/closure"
    },
    "diagnosis": {
      "$ref": "#/$defs/diagnosis"
    },
    "pricing": {
      "$ref": "#/$defs/pricing"
    },
    "primitives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/primitive"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data_source"
      }
    },
    "relation_source": {
      "$ref": "#/$defs/relation_source"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "derived_types": {
      "type": "array",
      "description": "派生对象类型：命名查询视图（组合代数/谓词），查询引擎 from:派生类型 时递归解析 derivation。",
      "items": {
        "$ref": "#/$defs/derivedType"
      }
    },
    "property_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyType"
      }
    },
    "state_machines": {
      "type": "object",
      "description": "按对象类型声明的状态机（Palantir 式 Object Type 状态机）。",
      "additionalProperties": {
        "$ref": "#/$defs/stateMachine"
      }
    },
    "abox_targets": {
      "$ref": "#/$defs/aboxTargets"
    },
    "contexts": {
      "type": "array",
      "description": "v4：限界上下文（fulfillment/pricing_billing/capacity/evidence_exception/master_data/operations）。裁剪与闭包的顶层单位。跨引用一致性由 semantic_gate.py#contexts_v4 负责，结构上允许扩展元数据属性。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "aggregates": {
            "$ref": "#/$defs/stringArray"
          },
          "version": {
            "type": "string"
          },
          "labels": {
            "$ref": "#/$defs/stringArray"
          },
          "invariants": {
            "type": "array"
          }
        }
      }
    },
    "aggregates": {
      "type": "array",
      "description": "v4：聚合（上下文内的一致性单元：根类型 + 成员 + 聚合内关系）。seed 注入单位。跨引用一致性由 semantic_gate.py#contexts_v4 负责，结构上允许扩展元数据属性。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "context",
          "root",
          "types"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "$ref": "#/$defs/typeId"
          },
          "types": {
            "$ref": "#/$defs/stringArray"
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "description": "v4：业务术语表（检索一等公民）。term/synonyms/colloquial → type_ref，口语与同义词是精确通道的强信号。",
      "items": {
        "type": "object",
        "required": [
          "term",
          "type_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "synonyms": {
            "$ref": "#/$defs/stringArray"
          },
          "colloquial": {
            "$ref": "#/$defs/stringArray"
          },
          "type_ref": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "based_on": {
          "type": "string"
        },
        "released_at": {
          "type": "string"
        },
        "storage_policy": {
          "type": "string",
          "enum": [
            "knowledge-only",
            "projection",
            "hybrid"
          ]
        }
      }
    },
    "class": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/typeId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "statuses": {
          "$ref": "#/$defs/stringArray"
        },
        "properties": {
          "$ref": "#/$defs/stringArray"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        },
        "rid": {
          "$ref": "#/$defs/rid",
          "description": "不可变标识（对标 Palantir Object Type rid）。与 id 分离：id 是可读稳定标识，rid 是内核身份，改名不变。"
        },
        "plural_display_name": {
          "type": "string",
          "minLength": 1,
          "description": "复数展示名（对标 Palantir pluralDisplayName）。中文无语态变化时等于 label；英文/i18n 场景由语言层覆盖。"
        },
        "display_metadata": {
          "$ref": "#/$defs/displayMetadata"
        },
        "primary_aggregate": {
          "type": "string",
          "minLength": 1,
          "description": "v4：该类型恰属一个的聚合 id（限界上下文内的一致性单元）。检索与注入以聚合为单位。"
        },
        "labels": {
          "$ref": "#/$defs/stringArray",
          "description": "v4：旧 35 域降级为 UI 多标签（仅导航；不参与裁剪与闭包）。"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "domain",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/relationId"
        },
        "label": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/typeId"
        },
        "range": {
          "$ref": "#/$defs/typeId"
        },
        "temporal": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ],
          "description": "链接基数（Palantir Link Type cardinality）：读法 domain->range。缺省 many_to_many（未声明的历史链接不限制）。"
        },
        "rid": {
          "$ref": "#/$defs/rid",
          "description": "不可变标识（对标 Palantir Link Type rid）。"
        },
        "boundary": {
          "type": "boolean",
          "description": "v4：跨聚合边界链接（domain/range 分属不同聚合）。注入层永不静默丢弃，端点带聚合名。"
        },
        "display_metadata": {
          "$ref": "#/$defs/displayMetadata"
        }
      }
    },
    "object_type_group": {
      "type": "object",
      "required": [
        "id",
        "label",
        "types"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/relationId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeId"
          },
          "minItems": 1
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "mode",
        "context_budget_chars"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "full_if_fits",
            "always_group",
            "always_full"
          ]
        },
        "context_budget_chars": {
          "type": "integer",
          "minimum": 500
        },
        "description_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "closure": {
      "type": "object",
      "required": [
        "mode",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "in",
              "out",
              "both"
            ]
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": [
        "seed_type",
        "required_relations"
      ],
      "additionalProperties": false,
      "properties": {
        "seed_type": {
          "$ref": "#/$defs/typeId"
        },
        "required_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationId"
          }
        },
        "claim": {
          "type": "string"
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "rule_id"
        ],
        "additionalProperties": true,
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "primitive": {
      "type": "object",
      "required": [
        "name",
        "description",
        "arguments",
        "required",
        "returns"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "required": {
          "$ref": "#/$defs/stringArray"
        },
        "returns": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "declaration",
            "deterministic",
            "agent"
          ],
          "description": "执行档位：declaration=只读本体声明；deterministic=声明+事实+规则求值(0 LLM)；agent=含大模型推理"
        }
      }
    },
    "function": {
      "type": "object",
      "required": [
        "id",
        "label",
        "target",
        "implementation",
        "params",
        "returns"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/relationId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/typeId"
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "returns": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "declaration",
            "deterministic",
            "agent"
          ],
          "description": "执行档位：declaration=只读本体声明；deterministic=声明+事实+规则求值(0 LLM)；agent=含大模型推理"
        }
      }
    },
    "data_source": {
      "type": "object",
      "required": [
        "class",
        "system",
        "tool",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "#/$defs/typeId"
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "fee_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "freshness_hours": {
          "type": "number",
          "minimum": 0
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relation_source": {
      "type": "object",
      "required": [
        "system",
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domain",
        "when",
        "judge"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/typeId"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "object",
          "description": "规则前置条件表达式；当前允许 all/any 等自由结构，G1-03 迁移为 AST。",
          "additionalProperties": true
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "formula": {
              "type": "string"
            },
            "ast": {
              "type": "object"
            },
            "calc": {
              "type": "object",
              "additionalProperties": true
            },
            "compute": {
              "type": "object",
              "additionalProperties": true
            },
            "allowed_actions": {
              "$ref": "#/$defs/stringArray"
            },
            "forbidden_actions": {
              "$ref": "#/$defs/stringArray"
            },
            "explain": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "formula"
              ]
            },
            {
              "required": [
                "ast"
              ]
            },
            {
              "required": [
                "allowed_actions"
              ]
            },
            {
              "required": [
                "forbidden_actions"
              ]
            }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "label",
        "target",
        "roles",
        "from_status",
        "to_status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/relationId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/typeId"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "$ref": "#/$defs/stringArray"
        },
        "from_status": {
          "$ref": "#/$defs/stringArray"
        },
        "to_status": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/valueType",
          "description": "参数类型（对标 Palantir Function 参数类型系统）。只能是标量类型或 object_set/object_ref/enum，不再接受任意字符串——自由字符串既无法生成强类型 OSDK 客户端，也无法做类型检查。"
        },
        "required": {
          "type": "boolean"
        },
        "of": {
          "$ref": "#/$defs/typeId",
          "description": "type=object_set / object_ref 时的对象类型（Palantir ObjectSet<T> 的元素类型）。"
        },
        "interface": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "参数按接口接受（Palantir interface-typed argument）：实参类必须 conforms 该接口。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "object_set",
                  "object_ref"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "of"
            ]
          }
        }
      ]
    },
    "valueType": {
      "type": "string",
      "enum": [
        "string",
        "text",
        "integer",
        "number",
        "decimal",
        "boolean",
        "datetime",
        "timestamp",
        "date",
        "json",
        "enum",
        "object_set",
        "object_ref"
      ],
      "description": "函数参数/返回值类型枚举。标量部分与 propertyType.value_type / base_type 对齐；datetime 与 timestamp 同义（属性侧用 datetime，函数侧历史上用 timestamp，两个名字都按 ISO 校验）；另有 object_set / object_ref 两个对象引用形态（对标 Palantir ObjectSet<T>）。"
    },
    "rid": {
      "type": "string",
      "pattern": "^ri\\.[a-z]+\\.[a-z0-9-]+\\.[a-z-]+\\.[0-9a-f]{32}$",
      "description": "不可变资源标识（Palantir rid 格式 ri.<service>.<instance>.<kind>.<uuid4hex>）。"
    },
    "displayMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "visibility": {
          "type": "string",

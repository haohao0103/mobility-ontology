 "function_registry": [
  {
   "id": "fee_breakdown",
   "label": "费用拆解",
   "version": "1.1.0",
   "owner": "freight-core",
   "implementation": "freight.engine.FreightSystem.fee_analysis",
   "description": "确定性拆解运单的报价、规则应计、实收、减免和差异。",
   "signature": {
    "params": [
     {
      "name": "waybill_id",
      "type": "string",
      "required": true
     },
     {
      "type": "string",
      "name": "version",
      "required": false
     }
    ],
    "returns": "FeeBreakdown"
   },
   "sandbox": {
    "timeout_ms": 5000,
    "memory_mb": 256
   },
   "accepts_interface": null,
   "tests": [
    {
     "name": "wb001-fee-sum-closes",
     "args": {
      "waybill_id": "waybill:WB20261105001"
     },
     "expect": {
      "status": "EXPLAINED"
     }
    }
   ]
  },
  {
   "id": "quote_reconcile",
   "label": "报价对账",
   "version": "1.0.0",
   "owner": "freight-core",
   "implementation": "freight.engine.FreightSystem.quote_reconcile",
   "description": "确定性对比订单报价明细与实际费用。",
   "signature": {
    "params": [
     {
      "name": "waybill_id",
      "type": "string",
      "required": true
     }
    ],
    "returns": "QuoteReconcile"
   },
   "sandbox": {
    "timeout_ms": 5000,
    "memory_mb": 256
   },
   "accepts_interface": "Chargeable",
   "tests": []
  },
  {
   "id": "chargeable_variance",
   "label": "可计费对象差异计算（接口多态示例）",
   "version": "1.0.0",
   "owner": "freight-core",
   "implementation": "enhancements.interfaces.compute_variance",
   "description": "按 Chargeable 接口接受任意实现类，计算金额口径差异；演示接口多态的函数路由。",
   "signature": {
    "params": [
     {
      "name": "object_id",
      "type": "string",
      "required": true,
      "interface": "Chargeable"
     }
    ],
    "returns": "number"
   },
   "sandbox": {
    "timeout_ms": 3000,
    "memory_mb": 128
   },
   "accepts_interface": "Chargeable",
   "tests": []
  },
  {
   "id": "fee_breakdown_batch",
   "label": "批量费用拆解",
   "version": "1.0.0",
   "owner": "freight-core",
   "implementation": "freight.engine.FreightSystem.fee_breakdown_batch",
   "description": "对整个运单对象集批量执行费用拆解（object_set 参数形态，对齐 Palantir Function 的 ObjectSet 入参）。",
   "signature": {
    "params": [
     {
      "name": "waybills",
      "type": "object_set",
      "of": "Waybill",
      "required": true,
      "description": "查询树(dict) 或对象 ID 列表(list)"
     }
    ],
    "returns": "FeeBreakdownBatch"
   },
   "sandbox": {
    "timeout_ms": 30000,
    "memory_mb": 512
   },
   "accepts_interface": null,
   "tests": [
    {
     "name": "batch-variance-sum",
     "args": {
      "waybills": {
       "set": {
        "from": "Waybill"
       }
      }
     },
     "expect": {
      "count": ">=1"
     }
    }
   ]
  }
 ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobility-ontology.local/schema/ontology_extension.schema.json",
  "title": "Ontology Extension Layer",
  "description": "扩展层（enhancements/ontology_extension.json）的元模型契约。对标 Palantir 追齐层的第二份本体：属性类型注册表 / 接口 / 安全标记 / 函数注册表。顶层 additionalProperties:false 是硬约束——扩展层没有 schema 就等于没有契约，任何垃圾键都会被静默接受。",
  "type": "object",
  "required": [
    "meta",
    "property_types"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "property_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyType"
      }
    },
    "property_registry_policy": {
      "$ref": "#/$defs/propertyRegistryPolicy"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "markings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marking"
      }
    },
    "data_source_markings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/markingRule"
      },
      "description": "数据源级标记：外部系统被打标后，映射到该系统的对象类型全部继承（marking 沿数据源传播）。"
    },
    "class_markings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/markingRule"
      },
      "description": "类级标记：直接挂在对象类型上的标记。"
    },
    "object_security_policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectSecurityPolicy"
      }
    },
    "property_security_policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertySecurityPolicy"
      }
    },
    "scope_tokens": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/scopeToken"
          }
        ]
      }
    },
    "function_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/functionEntry"
      }
    },
    "result_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resultType"
      },
      "description": "函数返回类型注册表。函数 returns 必须是标量 valueType、已声明的结果类型、或已定义的对象类型——不允许裸字符串。"
    },
    "lifecycle_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "worksheets": {
      "type": "array",
      "description": "Workshop 工作台声明：对象引用 + 视图配置。",
      "items": {
        "type": "object",
        "required": ["id", "objects"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "objects": { "type": "array", "items": { "type": "string" } },
          "view": { "enum": ["table", "graph"] },
          "columns": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "description": "Workflows 流程声明：步骤序列，支持 action/query/approval/edit。",
      "items": {
        "type": "object",
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": { "enum": ["action", "query", "approval", "edit"] },
                "action_id": { "type": "string" },
                "object_id": { "type": "string" },
                "role": { "type": "string" },
                "payload": { "type": "object" },
                "tool": { "type": "string" },
                "arguments": { "type": "object" },
                "approver": { "type": "string" },
                "set": { "type": "object" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "authz_engines": {
      "type": "object",
      "description": "授权引擎适配配置；内置 policy 直接可用，外部引擎为协议骨架。",
      "additionalProperties": { "type": "object" }
    },
    "action_effects": {
      "type": "object",
      "description": "动作成功提交后的副作用声明：webhook / notification / trigger。改此键即可挂摘副作用。",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["webhook", "notification", "trigger"] },
            "url": { "type": "string" },
            "channels": { "type": "array", "items": { "type": "string" } },
            "template": { "type": "string" },
            "action_id": { "type": "string" },
            "object_id": { "type": "string" },
            "payload": { "type": "object" },
            "idempotency_key": { "type": "string" },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "materialized_views": {
      "type": "array",
      "description": "OSv2 跨表物化视图声明：只改本体 JSON 即可启用，代码不硬编码业务类型。",
      "items": {
        "type": "object",
        "required": ["id", "root"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "root": { "type": "string", "minLength": 1 },
          "joins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["link"],
              "properties": {
                "link": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["out", "in"] },
                "as": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "properties": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "spatial_properties": {
      "type": "object",
      "description": "属性 -> 空间语义角色；声明后自动建地理索引（bbox 收窄）。",
      "additionalProperties": { "enum": ["latitude", "longitude"] }
    },
    "aggregate_precompute": {
      "type": "array",
      "description": "聚合预计算声明：group_by + metrics，带源计数新鲜度闸门。",
      "items": {
        "type": "object",
        "required": ["class"],
        "properties": {
          "class": { "type": "string", "minLength": 1 },
          "group_by": { "type": "array", "items": { "type": "string" } },
          "metrics": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "valueType": {
      "type": "string",
      "enum": [
        "string",
        "text",
        "integer",
        "number",
        "decimal",
        "boolean",
        "datetime",
        "date",
        "json",
        "enum"
      ]
    },
    "baseType": {
      "type": "string",
      "enum": [
        "string",
        "int",
        "double",
        "boolean",
        "timestamp",
        "date"
      ]
    },
    "propertyType": {
      "type": "object",
      "required": [
        "name",
        "value_type",
        "base_type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "value_type": {
          "$ref": "#/$defs/valueType"
        },
        "base_type": {
          "$ref": "#/$defs/baseType"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "marking": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeseries": {
          "type": "boolean"
        },
        "primary_key": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "source_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "iri": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "used_by": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "propertyRegistryPolicy": {
      "type": "object",
      "required": [
        "enforcement"
      ],
      "additionalProperties": false,
      "properties": {
        "enforcement": {
          "type": "string",
          "enum": [
            "incremental",
            "strict"
          ],
          "description": "incremental：新增属性必须先注册，存量豁免。strict：全部属性强制注册，legacy 通道关闭。"
        },
        "legacy_grace": {
          "type": "boolean",
          "description": "存量属性豁免开关。strict 模式下必须为 false，否则 strict 是空话。"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "id",
        "label",
        "match"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "match": {
          "type": "string",
          "enum": [
            "structural",
            "explicit"
          ],
          "description": "structural：按属性 shape 自动匹配（Palantir structural interface）。explicit：只认 implements 显式声明（Palantir 显式 implementsInterfaces）。"
        },
        "required_properties": {
          "$ref": "#/$defs/stringArray"
        },
        "required_any_of": {
          "$ref": "#/$defs/stringArray"
        },
        "required_timeseries": {
          "$ref": "#/$defs/stringArray"
        },
        "implements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "object_type"
            ],
            "additionalProperties": false,
            "properties": {
              "object_type": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "property_map": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "接口属性名 -> 实现类属性名（Palantir interface 属性映射）。缺省同名。"
              }
            }
          },
          "description": "显式实现声明（对标 Palantir implementsInterfaces2）。显式声明优先于 structural 匹配。"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "markingRule": {
      "type": "object",
      "required": [
        "marking"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "description": "data_source_markings 用：外部系统名（与 data_sources.system 对齐）。"
        },
        "object_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "class_markings 用：对象类型 id。"
        },
        "marking": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "marking": {
      "type": "object",
      "required": [
        "id",
        "label",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "标记类别。Palantir 的四类标准值是 Information / Organization / Classification / Compartment；业务自定义类别（如 Finance / Operations）同样合法，因此这里不锁枚举——锁死会逼业务造词，那是假的严格。"
        },
        "members": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "objectSecurityPolicy": {
      "type": "object",
      "required": [
        "id",
        "object_type",
        "required_marking"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "row_filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "property": {
              "type": "string",
              "minLength": 1
            },
            "equals": {}
          }
        },
        "required_marking": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "propertySecurityPolicy": {
      "type": "object",
      "required": [
        "id",
        "properties",
        "required_marking"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/stringArray"
        },
        "required_marking": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scopeToken": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "$ref": "#/$defs/stringArray"
        },
        "functions": {
          "$ref": "#/$defs/stringArray"
        },
        "mcp_tools": {
          "$ref": "#/$defs/stringArray"
        },
        "markings": {
          "$ref": "#/$defs/stringArray",
          "description": "令牌自身带有的标记成员集（marking 传播：令牌不能导出高于自身的标记内容）。"
        }
      }
    },
    "functionParam": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "text",
            "integer",
            "number",
            "decimal",
            "boolean",
            "timestamp",
            "date",
            "json",
            "enum",
            "object_set",
            "object_ref"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "interface": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "object_set",
                  "object_ref"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "of"
            ]
          }
        }
      ]
    },
    "functionSignature": {
      "type": "object",
      "required": [
        "params",
        "returns"
      ],
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/functionParam"
          }
        },
        "returns": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resultType": {
      "type": "object",
      "required": [
        "id",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "text",
                  "integer",
                  "number",
                  "decimal",
                  "boolean",
                  "timestamp",
                  "date",
                  "json",
                  "enum",
                  "object_set",
                  "object_ref"
                ]
              },
              "label": {
                "type": "string"
              },
              "nullable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "functionEntry": {
      "type": "object",
      "required": [
        "id",
        "label",
        "implementation",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "accepts_interface": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature": {
          "$ref": "#/$defs/functionSignature"
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "object"
              },
              "expect": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
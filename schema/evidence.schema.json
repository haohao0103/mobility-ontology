{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "description": "判断与提议所依据的证据项。契约见 plan/judgment-proposal-contract.md 第 3 节。",
  "type": "object",
  "required": [
    "evidence_id",
    "evidence_type",
    "source_system",
    "occurred_at",
    "required_by_rule",
    "present"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1,
      "description": "如 ETC_RECORD、POD、EVENT_LOG"
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": ["string", "null"]
    },
    "checksum": {
      "type": ["string", "null"]
    },
    "required_by_rule": {
      "type": "boolean"
    },
    "present": {
      "type": "boolean"
    }
  }
}
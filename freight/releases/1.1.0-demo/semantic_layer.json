  "relation_source": {
    "system": "图查询 / MCP",
    "tool": "graph.list_relations",
    "description": "关系实例按主语、谓语与方向实时查询；本体只保存关系定义。"
  },
  "rules": [
    {
      "id": "R-WAIT-01",
      "name": "等候费计算规则",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "waiting"
          }
        ]
      },
      "judge": {
        "formula": "ceil(max(0, waiting_minutes - free_wait_minutes) / 5) * 2.4",
        "explain": "等候费按每 5 分钟 2.4 元计，前 20 分钟免费。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-HIGHWAY-01",
      "name": "高速费据实结算",
      "domain": "FeeItem",
      "when": {
        "all": [
          {
            "field": "fee_type",
            "op": "eq",
            "value": "highway"
          }
        ]
      },
      "judge": {
        "formula": "以 ETC 扣费记录为准",
        "explain": "高速费必须有 ETC 扣费记录作为证据，不能手工估算。",
        "severity": "MEDIUM"
      }
    },
    {
      "id": "R-WAYBILL-01",
      "name": "装货后不可改派",
      "domain": "Waybill",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "in",
            "value": [
              "LOADED",
              "DELIVERED"
            ]
          }
        ]
      },
      "judge": {
        "forbidden_actions": [
          "reassign_waybill"
        ],
        "explain": "货物已装车后改派会破坏履约连续性；只能走异常工单流程。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-SETTLE-01",
      "name": "已入账只能冲正",
      "domain": "Settlement",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "eq",
            "value": "POSTED"
          }
        ]
      },
      "judge": {
        "forbidden_actions": [
          "hold_settlement"
        ],
        "allowed_actions": [
          "reverse_entry"
        ],
        "explain": "结算单已入账后不能直接改数或挂起，只能通过冲正留下调整痕迹。",
        "severity": "HIGH"
      }
    },
    {
      "id": "R-INVOICE-01",
      "name": "发票金额同步结算单",
      "domain": "Invoice",
      "when": {
        "all": [
          {
            "field": "status",
            "op": "in",
            "value": [
              "DRAFT",
              "ISSUED"
            ]
          }
        ]
      },
      "judge": {
        "formula": "invoice.amount == settlement.amount",
        "explain": "发票金额必须与结算单一致；结算冲正后发票需同步红冲。",
        "severity": "HIGH"
      }
    }
  ],
  "actions": [
    {
      "id": "accept_order",
      "label": "接单",
      "target": "Waybill",
      "roles": [
        "driver",
        "dispatcher"
      ],
      "from_status": [
        "CREATED",
        "REASSIGNED"
      ],
      "to_status": "ACCEPTED",
      "params": [],
      "description": "司机确认承接运单，记录接单时间。"
    },
    {
      "id": "reassign_waybill",
      "label": "改派",
      "target": "Waybill",
      "roles": [
        "dispatcher",
        "supervisor"
      ],
      "from_status": [
        "CREATED",
        "ACCEPTED"
      ],
      "to_status": "REASSIGNED",
      "params": [
        {
          "name": "new_driver_id",
          "label": "新司机 ID",
          "type": "string",
          "required": true
        }
      ],
      "description": "装货前可改派；装货后必须走异常工单。"
    },
    {
      "id": "confirm_loading",
      "label": "装货确认",
      "target": "Waybill",
      "roles": [
        "driver"
      ],
      "from_status": [
        "ACCEPTED"
      ],
      "to_status": "LOADED",
      "params": [],
      "description": "司机确认货物已装载，记录装货完成时间并生成证据。"
    },
    {
      "id": "complete",
      "label": "送达",
      "target": "Waybill",
      "roles": [
        "driver"
      ],
      "from_status": [
        "LOADED"
      ],
      "to_status": "DELIVERED",
      "params": [
        {
          "name": "proof_of_delivery",
          "label": "回单编号",
          "type": "string",
          "required": true
        }
      ],
      "description": "送达并上传回单，缺回单不能进入结算。"
    },
    {
      "id": "dispute_charge",
      "label": "发起费用申诉",
      "target": "FeeItem",
      "roles": [
        "shipper",
        "customer_service",
        "driver"
      ],
      "from_status": [
        "NORMAL"
      ],
      "to_status": "DISPUTED",
      "params": [
        {
          "name": "reason",
          "label": "申诉原因",
          "type": "string",
          "required": true
        }
      ],
      "description": "对费用发起申诉，自动创建并关联异常工单。"
    },
    {
      "id": "waive_charge",
      "label": "减免费用",
      "target": "FeeItem",
      "roles": [
        "finance",
        "supervisor"
      ],
      "from_status": [
        "DISPUTED"
      ],
      "to_status": "WAIVED",
      "params": [
        {
          "name": "amount",
          "label": "减免金额",
          "type": "number",
          "required": true
        }
      ],
      "description": "审批通过后减免费用；结算已入账时还需执行冲正。"
    },
    {
      "id": "hold_settlement",
      "label": "挂起结算",
      "target": "Settlement",
      "roles": [
        "finance"
      ],
      "from_status": [
        "DRAFT",
        "PENDING"
      ],
      "to_status": "ON_HOLD",
      "params": [
        {
          "name": "reason",
          "label": "挂起原因",
          "type": "string",
          "required": false
        }
      ],
      "description": "未入账的结算单可以挂起；已入账只能冲正。"
    },
    {
      "id": "reverse_entry",
      "label": "冲正",
      "target": "Settlement",
      "roles": [
        "finance",
        "supervisor"
      ],
      "from_status": [
        "POSTED"
      ],
      "to_status": "REVERSED",
      "params": [
        {
          "name": "amount",
          "label": "冲正金额（留空按已减免金额）",
          "type": "number",
          "required": false
        }
      ],
      "description": "对已入账结算做冲正，并同步发票金额与状态。"
    },
    {
      "id": "void_invoice",
      "label": "发票红冲",
      "target": "Invoice",
      "roles": [
        "finance"
      ],
      "from_status": [
        "ISSUED"
      ],
      "to_status": "VOIDED",
      "params": [
        {
          "name": "reason",
          "label": "红冲原因",
          "type": "string",
          "required": false
        }
      ],
      "description": "结算冲正后同步红冲发票。"
    },
    {
      "id": "close_exception",
      "label": "关闭异常工单",
      "target": "ExceptionTicket",
      "roles": [
        "customer_service",
        "supervisor"
      ],
      "from_status": [
        "OPEN",
        "PROCESSING"
      ],
      "to_status": "CLOSED",
      "params": [
        {
          "name": "resolution",
          "label": "处理结论",
          "type": "string",
          "required": true
        }
      ],
      "description": "关闭异常工单必须留下处理结论。"
    }
  ]
}
